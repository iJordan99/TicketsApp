<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TicketsApp.Views.TicketDetailsPage"
             xmlns:viewModel="clr-namespace:TicketsApp.ViewModels"
             xmlns:model="clr-namespace:TicketsApp.Models"
             x:DataType="viewModel:TicketDetailsViewModel"
             BackgroundColor="#C0C8CA">

    <ContentPage.Resources>
        <ResourceDictionary />
    </ContentPage.Resources>


    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">

        <ScrollView>

            <VerticalStackLayout Padding="20"
                                 Spacing="10">
                <Border HorizontalOptions="FillAndExpand"
                        Padding="10"
                        BackgroundColor="White">

                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding TicketData, Converter={StaticResource TicketFormatConverter}}"
                               TextColor="{Binding TicketData.Priority, Converter={StaticResource PriorityToColorConverter}}"
                               VerticalTextAlignment="Center"
                               FontSize="21"
                               FontFamily="LexendBold" />

                        <Label Text="{Binding TicketData.Description}"
                               VerticalTextAlignment="Center"
                               Margin="0,5,0,0"
                               TextColor="#1A2D42"
                               FontSize="21"
                               FontFamily="LexendLight" />

                        <Label Text="Reproduction Step"
                               VerticalTextAlignment="Center"
                               Margin="0,5,0,0"
                               TextColor="{StaticResource Primary}"
                               FontSize="21"
                               FontFamily="LexendBold" />

                        <Label Text="{Binding TicketData.ReproductionStep}"
                               VerticalTextAlignment="Center"
                               Margin="0,5,0,0"
                               TextColor="#1A2D42"
                               FontSize="21"
                               FontFamily="LexendLight" />

                        <Label Text="Error Code"
                               VerticalTextAlignment="Center"
                               Margin="0,5,0,0"
                               TextColor="{StaticResource Primary}"
                               FontSize="21"
                               FontFamily="LexendBold" />

                        <Label Text="{Binding TicketData.ErrorCode}"
                               Margin="0,5,0,0"
                               TextColor="#1A2D42"
                               FontSize="21"
                               FontFamily="LexendLight" />

                        <Label Text="Created"
                               VerticalTextAlignment="Center"
                               Margin="0,5,0,0"
                               TextColor="{StaticResource Primary}"
                               FontSize="21"
                               FontFamily="LexendBold" />

                        <Label Text="{Binding TicketData.CreatedOn}"
                               VerticalTextAlignment="Center"
                               Margin="0,5,0,0"
                               TextColor="#1A2D42"
                               FontSize="21"
                               FontFamily="LexendLight" />

                        <Label Text="Last Updated"
                               TextColor="{StaticResource Primary}"
                               Margin="0,5,0,0"
                               FontSize="21"
                               FontFamily="LexendBold" />

                        <Label Text="{Binding TicketData.UpdatedOn}"
                               VerticalTextAlignment="Center"
                               Margin="0,5,0,0"
                               TextColor="#1A2D42"
                               FontSize="21"
                               FontFamily="LexendLight" />

                        <VerticalStackLayout Spacing="15">
                            <Label Text="Author"
                                   FontSize="21"
                                   FontFamily="LexendBold"
                                   TextColor="{StaticResource Primary}" />

                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding TicketData.Author.Name}"
                                       FontSize="21"
                                       FontFamily="LexendLight"
                                       TextColor="#1A2D42" />

                                <Label Text="{Binding TicketData.Author.Email}"
                                       FontSize="21"
                                       FontFamily="LexendLight"
                                       TextColor="#1A2D42" />
                            </HorizontalStackLayout>

                            <Label
                                Text="{Binding TicketData.Engineers.Count, StringFormat='Assigned Engineers [ {0} ]'}"
                                FontSize="21"
                                FontFamily="LexendBold"
                                TextColor="{StaticResource Primary}" />

                            <CollectionView ItemsSource="{Binding TicketData.Engineers}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                                                     Span="7" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type model:User}">
                                        <Border HorizontalOptions="FillAndExpand"
                                                BackgroundColor="White">

                                            <VerticalStackLayout>

                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="{Binding Name}"
                                                           TextColor="{StaticResource Primary}"
                                                           VerticalTextAlignment="Center"
                                                           FontSize="21"
                                                           FontFamily="LexendRegular" />

                                                    <Button
                                                        Text="Remove"
                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModel:TicketDetailsViewModel}}, Path=IsEngineer }"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="White"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModel:TicketDetailsViewModel}}, Path=RemoveEngineerCommand}"
                                                        CommandParameter="{Binding .}" />

                                                </HorizontalStackLayout>


                                                <Label Text="{Binding Email}"
                                                       VerticalTextAlignment="Center"
                                                       Margin="0,5,0,0"
                                                       TextColor="{StaticResource PrimaryDark}"
                                                       FontSize="21"
                                                       FontFamily="LexendThin"
                                                       MaxLines="3" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Comments"
                       Margin="5,10,0,0"
                       TextColor="{StaticResource Primary}"
                       FontSize="21"
                       FontFamily="LexendLight" />

                <Border HorizontalOptions="FillAndExpand"
                        Padding="10"
                        BackgroundColor="White">


                    <VerticalStackLayout>
                        <CollectionView ItemsSource="{Binding TicketData.Comments}"
                                        HeightRequest="300">
                            <CollectionView.Triggers>
                                <DataTrigger TargetType="CollectionView"
                                             Binding="{Binding TicketData.Comments.Count}"
                                             Value="0">
                                    <Setter Property="HeightRequest" Value="0" />
                                </DataTrigger>
                            </CollectionView.Triggers>
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type model:Comment}">
                                    <Grid ColumnDefinitions="50, *" RowDefinitions="Auto, Auto" Padding="10">

                                        <Image Grid.RowSpan="2"
                                               Grid.Column="0"
                                               Source="person.png"
                                               HeightRequest="50"
                                               WidthRequest="50"
                                               Aspect="AspectFill"
                                               VerticalOptions="Start"
                                               Margin="5" />

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="5"
                                                             Margin="5,0,0,0">
                                            <Label Text="{Binding User.Name}"
                                                   FontSize="21"
                                                   FontFamily="LexendBold"
                                                   TextColor="{Binding User, Converter={StaticResource EngineerToColourConverter}}"
                                                   VerticalTextAlignment="Center" />
                                            <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy - h:mm tt}'}"
                                                   FontSize="21"
                                                   FontFamily="LexendLight"
                                                   TextColor="{StaticResource PrimaryLight}"
                                                   VerticalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="21"
                                               FontFamily="LexendLight"
                                               TextColor="#1A2D42"
                                               VerticalTextAlignment="Start"
                                               Margin="5,5,0,5" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Grid ColumnDefinitions="*, Auto" Padding="10" ColumnSpacing="10">
                            <Entry
                                Placeholder="New Comment"
                                PlaceholderColor="{StaticResource Primary}"
                                TextColor="#1A2D42"
                                FontSize="18"
                                FontFamily="LexendLight"
                                HeightRequest="55"
                                Text="{Binding NewComment}"
                                Margin="0,0,10,0"
                                BackgroundColor="Transparent" />

                            <Button Grid.Column="1"
                                    Text=" + "
                                    FontFamily="LexendSemiBold"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    Padding="10,10"
                                    Command="{Binding AddCommentCommand}"
                                    CornerRadius="10" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Assign Engineer"
                       Margin="5,10,0,0"
                       TextColor="{StaticResource Primary}"
                       FontSize="21"
                       FontFamily="LexendLight"
                       IsVisible="{Binding IsEngineer}" />

                <Border HorizontalOptions="FillAndExpand"
                        Padding="10"
                        BackgroundColor="White"
                        IsVisible="{Binding IsEngineer}">

                    <CollectionView ItemsSource="{Binding Engineers}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="7"
                                             HorizontalItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type model:User}">
                                <Border HorizontalOptions="FillAndExpand"
                                        BackgroundColor="White">

                                    <VerticalStackLayout Spacing="5">

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{Binding Name}"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalTextAlignment="Center"
                                                   FontSize="21"
                                                   FontFamily="LexendRegular" />

                                            <Button
                                                Text="Assign"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModel:TicketDetailsViewModel}}, Path=AssignEngineerCommand}"
                                                CommandParameter="{Binding .}" />

                                        </HorizontalStackLayout>


                                        <Label Text="{Binding Email}"
                                               VerticalTextAlignment="Center"
                                               TextColor="{StaticResource PrimaryDark}"
                                               FontSize="21"
                                               FontFamily="LexendThin"
                                               MaxLines="3" />

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>


                <Grid ColumnDefinitions="*,*"
                      HorizontalOptions="FillAndExpand"
                      ColumnSpacing="20">
                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="10"
                                           HorizontalOptions="Start"
                                           IsVisible="{Binding IsEngineer}">

                        <Label Text="Priority :"
                               Margin="5,10,0,0"
                               TextColor="{StaticResource Primary}"
                               FontSize="21"
                               FontFamily="LexendLight" />

                        <Button
                            Text="High"
                            BackgroundColor="#B91C1C"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding UpdatePriorityCommand}"
                            CommandParameter="High" />

                        <Button
                            Text="Medium"
                            BackgroundColor="#D97706"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding UpdatePriorityCommand}"
                            CommandParameter="Medium" />

                        <Button
                            Text="Low"
                            BackgroundColor="#047857"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding UpdatePriorityCommand}"
                            CommandParameter="low" />

                    </HorizontalStackLayout>


                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="10"
                                           HorizontalOptions="End"
                                           IsVisible="{Binding IsEngineer}">

                        <Label Text="Status :"
                               Margin="5,10,0,0"
                               TextColor="{StaticResource Primary}"
                               FontSize="21"
                               FontFamily="LexendLight" />

                        <Button
                            Text="Active"
                            BackgroundColor="Green"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding UpdateStatusCommand}"
                            CommandParameter="A" />

                        <Button
                            Text="Hold"
                            BackgroundColor="Orange"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding UpdateStatusCommand}"
                            CommandParameter="H" />

                        <Button
                            Text="Cancel"
                            BackgroundColor="Gray"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding UpdateStatusCommand}"
                            CommandParameter="X" />

                        <Button
                            Text="Close"
                            BackgroundColor="DarkBlue"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding UpdateStatusCommand}"
                            CommandParameter="C" />

                        <Button
                            Text="Delete"
                            BackgroundColor="Red"
                            TextColor="White"
                            Margin="0,5,0,0"
                            FontSize="18"
                            FontFamily="LexendRegular"
                            Command="{Binding DeleteTicketCommand}"
                            CommandParameter="{Binding Ticket}" />
                    </HorizontalStackLayout>
                    <Button
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsNotEngineer}"
                        Text="Delete"
                        BackgroundColor="Red"
                        TextColor="White"
                        Margin="0,5,0,0"
                        FontSize="18"
                        FontFamily="LexendRegular"
                        Command="{Binding DeleteTicketCommand}"
                        CommandParameter="{Binding Ticket}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>