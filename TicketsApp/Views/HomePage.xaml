<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TicketsApp.Views.HomePage"
             xmlns:viewModel="clr-namespace:TicketsApp.ViewModels"
             xmlns:model="clr-namespace:TicketsApp.Models"
             x:DataType="viewModel:HomePageViewModel"
             BackgroundColor="#CFD9E4"
             Shell.BackgroundColor="#CFD9E4">
    <ContentPage.Resources>
        <ResourceDictionary />
    </ContentPage.Resources>

    <Grid
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
        Margin="30,0,30,0"
        RowSpacing="20">

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Grid.RowSpan="7" />


        <Grid Grid.Row="0" Margin="0,0,0,0">
            <Label Text="{Binding Username, StringFormat='Welcome {0}'}"
                   FontFamily="LexendBold"
                   FontSize="21"
                   TextColor="{StaticResource PrimaryLight}"
                   VerticalTextAlignment="Center"
                   HorizontalOptions="Start" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              VerticalOptions="Center"
              Padding="5">

            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="10"
                                   VerticalOptions="Center">
                <Label Text="Assigned Tickets"
                       FontFamily="LexendLight"
                       FontSize="21"
                       TextColor="{StaticResource PrimaryLight}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding IsEngineer}" />

                <Label Text="Current Tickets"
                       FontFamily="LexendLight"
                       FontSize="21"
                       TextColor="{StaticResource PrimaryLight}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding IsNotEngineer}" />

                <Button Text="Create"
                        FontFamily="LexendRegular"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        Command="{Binding CreateTicketCommand}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsEngineer}"
                                   Spacing="5">
                <Button Text="High Priority"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="Red"
                        Padding="10"
                        Command="{Binding FilterAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.High}" />
                <Button Text="Medium Priority"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="DarkOrange"
                        Padding="10"
                        Command="{Binding FilterAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.Medium}" />
                <Button Text="Low Priority"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="Green"
                        Padding="10"
                        Command="{Binding FilterAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.Low}" />
                <Button Text="Clear"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="Grey"
                        Padding="10"
                        Command="{Binding FilterAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.None}" />
            </HorizontalStackLayout>
        </Grid>

        <RefreshView
            HeightRequest="550"
            Grid.Row="2"
            IsVisible="{Binding IsAdmin}"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">
                    <CollectionView ItemsSource="{Binding AssignedTickets}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="5"
                                             HorizontalItemSpacing="15"
                                             VerticalItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type model:Ticket}">
                                <Border HorizontalOptions="FillAndExpand"
                                        Padding="10"
                                        HeightRequest="170"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TicketDetailsCommand}"
                                            CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding ., Converter={StaticResource TicketFormatConverter}}"
                                               TextColor="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                               VerticalTextAlignment="Center"
                                               FontSize="21"
                                               FontFamily="LexendBold" />
                                        <Label Text="{Binding Description}"
                                               VerticalTextAlignment="Center"
                                               Margin="0,10,0,0"
                                               TextColor="#1A2D42"
                                               FontSize="21"
                                               FontFamily="LexendLight"
                                               MaxLines="3"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <RefreshView Grid.Row="2"
                     HeightRequest="300"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsNotEngineer}">

            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">
                    <CollectionView ItemsSource="{Binding UserTickets}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="5"
                                             HorizontalItemSpacing="15"
                                             VerticalItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type model:Ticket}">
                                <Border HorizontalOptions="FillAndExpand"
                                        Padding="10"
                                        HeightRequest="75"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TicketDetailsCommand}"
                                            CommandParameter="{Binding}" />

                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}"
                                               TextColor="{StaticResource Primary}"
                                               VerticalTextAlignment="Center"
                                               FontSize="21"
                                               FontFamily="LexendBold" />
                                        <Label Text="{Binding Description}"
                                               VerticalTextAlignment="Center"
                                               Margin="0,10,0,0"
                                               TextColor="#1A2D42"
                                               FontSize="21"
                                               FontFamily="LexendLight"
                                               MaxLines="3"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>


        <HorizontalStackLayout
            Grid.Row="3"
            HorizontalOptions="End"
            IsVisible="{Binding IsAdmin}">
            <Button
                Command="{Binding PreviousPageCommand}"
                CommandParameter="{x:Static viewModel:TicketPageType.Assigned}"
                Text="Previous Page"
                TextColor="{StaticResource PrimaryLight}"
                FontSize="18"
                FontFamily="LexendSemiBold"
                Margin="0,0,0,10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding AssignedCurrentPage}" Value="1">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Label
                VerticalOptions="Center"
                Margin="0,0,0,10">
                <Label.Text>
                    <MultiBinding StringFormat="[ {0}/{1} ]">
                        <Binding Path="AssignedCurrentPage" />
                        <Binding Path="AssignedLastPage" />
                    </MultiBinding>
                </Label.Text>
                <Label.FontSize>18</Label.FontSize>
                <Label.TextColor>
                    <StaticResource Key="PrimaryLight" />
                </Label.TextColor>
                <Label.FontFamily>LexendSemiBold</Label.FontFamily>
            </Label>
            <Button
                Command="{Binding NextPageCommand}"
                CommandParameter="{x:Static viewModel:TicketPageType.Assigned}"
                Text="Next Page"
                TextColor="{StaticResource PrimaryLight}"
                FontSize="18"
                FontFamily="LexendSemiBold"
                Margin="0,0,0,10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding AssignedCurrentPage}"
                                 Value="{Binding AssignedLastPage}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>


        <HorizontalStackLayout
            Grid.Row="3"
            HorizontalOptions="End"
            IsVisible="{Binding IsNotEngineer}">
            <Button
                Command="{Binding PreviousPageCommand}"
                CommandParameter="{x:Static viewModel:TicketPageType.User}"
                Text="Previous Page"
                TextColor="{StaticResource PrimaryLight}"
                FontSize="18"
                FontFamily="LexendSemiBold"
                Margin="0,0,0,10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding UserTicketCurrentPage}" Value="1">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Label
                VerticalOptions="Center"
                Margin="0,0,0,10">
                <Label.Text>
                    <MultiBinding StringFormat="[ {0}/{1} ]">
                        <Binding Path="UserTicketCurrentPage" />
                        <Binding Path="UserTicketLastPage" />
                    </MultiBinding>
                </Label.Text>
                <Label.FontSize>18</Label.FontSize>
                <Label.TextColor>
                    <StaticResource Key="PrimaryLight" />
                </Label.TextColor>
                <Label.FontFamily>LexendSemiBold</Label.FontFamily>
            </Label>
            <Button
                Command="{Binding NextPageCommand}"
                CommandParameter="{x:Static viewModel:TicketPageType.User}"
                Text="Next Page"
                TextColor="{StaticResource PrimaryLight}"
                FontSize="18"
                FontFamily="LexendSemiBold"
                Margin="0,0,0,10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding UserTicketCurrentPage}"
                                 Value="{Binding UserTicketLastPage}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Grid Grid.Row="4"
              ColumnDefinitions="Auto,*"
              VerticalOptions="Center"
              Padding="5">

            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="10"
                                   VerticalOptions="Center">
                <Label Text="Unassigned Tickets"
                       FontFamily="LexendLight"
                       FontSize="21"
                       TextColor="{StaticResource PrimaryLight}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding IsEngineer}" />

                <Label Text="Current Tickets"
                       FontFamily="LexendLight"
                       FontSize="21"
                       TextColor="{StaticResource PrimaryLight}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding IsNotEngineer}" />

            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsEngineer}"
                                   Spacing="5">
                <Button Text="High Priority"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="Red"
                        Padding="10"
                        Command="{Binding FilterUnAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.High}" />
                <Button Text="Medium Priority"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="DarkOrange"
                        Padding="10"
                        Command="{Binding FilterUnAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.Medium}" />
                <Button Text="Low Priority"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="Green"
                        Padding="10"
                        Command="{Binding FilterUnAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.Low}" />

                <Button Text="Clear"
                        FontSize="18"
                        FontFamily="LexendBold"
                        TextColor="White"
                        BackgroundColor="Grey"
                        Padding="10"
                        Command="{Binding FilterUnAssignedByPriorityCommand}"
                        CommandParameter="{x:Static viewModel:PriorityFilterType.None}" />
            </HorizontalStackLayout>
        </Grid>

        <RefreshView
            Grid.Row="5"
            HeightRequest="300"
            IsVisible="{Binding IsAdmin}"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">
                    <CollectionView ItemsSource="{Binding UnassignedTickets}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="5"
                                             HorizontalItemSpacing="15"
                                             VerticalItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type model:Ticket}">
                                <Border HorizontalOptions="FillAndExpand"
                                        Padding="10"
                                        HeightRequest="75"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TicketDetailsCommand}"
                                            CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding ., Converter={StaticResource TicketFormatConverter}}"
                                               TextColor="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                               VerticalTextAlignment="Center"
                                               FontSize="21"
                                               FontFamily="LexendBold" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <HorizontalStackLayout
            Grid.Row="6"
            HorizontalOptions="End"
            IsVisible="{Binding IsAdmin}">
            <Button
                Command="{Binding PreviousPageCommand}"
                CommandParameter="{x:Static viewModel:TicketPageType.Unassigned}"
                Text="Previous Page"
                TextColor="{StaticResource PrimaryLight}"
                FontSize="18"
                FontFamily="LexendSemiBold"
                Margin="0,0,0,10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding UnassignedCurrentPage}" Value="1">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Label
                VerticalOptions="Center"
                Margin="0,0,0,10">
                <Label.Text>
                    <MultiBinding StringFormat="[ {0}/{1} ]">
                        <Binding Path="UnassignedCurrentPage" />
                        <Binding Path="UnassignedLastPage" />
                    </MultiBinding>
                </Label.Text>
                <Label.FontSize>18</Label.FontSize>
                <Label.TextColor>
                    <StaticResource Key="PrimaryLight" />
                </Label.TextColor>
                <Label.FontFamily>LexendSemiBold</Label.FontFamily>
            </Label>
            <Button
                Command="{Binding NextPageCommand}"
                CommandParameter="{x:Static viewModel:TicketPageType.Unassigned}"
                Text="Next Page"
                TextColor="{StaticResource PrimaryLight}"
                FontSize="18"
                FontFamily="LexendSemiBold"
                Margin="0,0,0,10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding UnassignedCurrentPage}"
                                 Value="{Binding UnassignedLastPage}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>