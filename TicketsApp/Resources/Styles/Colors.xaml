<?xml version="1.0" encoding="UTF-8"?>
<?xaml-comp compile="true" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary Colors -->
    <Color x:Key="Primary">#224C7A</Color> <!-- Deep Blue - Your original color -->
    <Color x:Key="PrimaryDark">#193758</Color> <!-- Darker Blue -->
    <Color x:Key="PrimaryLight">#4B7297</Color> <!-- Lighter Blue -->

    <!-- Secondary Colors -->
    <Color x:Key="Secondary">#F0B775</Color> <!-- Warm Orange - Complementary -->
    <Color x:Key="SecondaryDark">#D69654</Color> <!-- Darker Orange -->
    <Color x:Key="SecondaryLight">#FFD4A5</Color> <!-- Light Orange -->

    <!-- Accent Colors -->
    <Color x:Key="Accent1">#4CAF8F</Color> <!-- Teal Green -->
    <Color x:Key="Accent2">#E85D75</Color> <!-- Coral Pink -->
    <Color x:Key="Accent3">#8C67B5</Color> <!-- Purple -->

    <!-- Neutral Colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray50">#F8F9FA</Color>
    <Color x:Key="Gray100">#EBEEF2</Color>
    <Color x:Key="Gray200">#D5DCE4</Color>
    <Color x:Key="Gray300">#B7C1CD</Color>
    <Color x:Key="Gray400">#99A5B5</Color>
    <Color x:Key="Gray500">#7B8A9E</Color>
    <Color x:Key="Gray600">#5D6E85</Color>
    <Color x:Key="Gray700">#45536A</Color>
    <Color x:Key="Gray800">#2E3950</Color>
    <Color x:Key="Gray900">#1A2436</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#4CAF8F</Color> <!-- Same as Accent1 -->
    <Color x:Key="Warning">#F0B775</Color> <!-- Same as Secondary -->
    <Color x:Key="Error">#E85D75</Color> <!-- Same as Accent2 -->
    <Color x:Key="Info">#4B7297</Color> <!-- Same as PrimaryLight -->

    <!-- Background Colors -->
    <Color x:Key="BackgroundLight">#F8F9FA</Color> <!-- Same as Gray50 -->
    <Color x:Key="BackgroundDark">#1A2436</Color> <!-- Same as Gray900 -->
</ResourceDictionary>